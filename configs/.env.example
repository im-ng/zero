# Zero configuration template — copy to configs/.env and uncomment what you need.
# Every key is OFF by default; features activate only when set. See docs/CONFIG_REFERENCE.md.

# ---- Application ----
# APP_ENV=production
# APP_NAME=zero-app
# APP_VERSION=0.1.0
# HTTP_PORT=8080
# LOG_FORMAT=                          # blank = default logger; "json" for JSON lines
# ZERO_LOG_TIMEZONE=
# ZERO_KEEPALIVE_TIMEOUT_MS=
# ZERO_FRAMEWORK_MEM_SIZE=             # pre-allocated bootstrap arena bytes
# INBOUND_MAX_CONCURRENT=
# REQUIRED_CONFIG_KEYS=                # comma list; fail-fast if unset
# RBAC_CONFIG=                         # path to RBAC rules
# METRICS_PORT=
# METRICS_CARDINALITY_LIMIT=
# CONSUMER_ID=

# ---- Health & shutdown ----
# Health snapshot refresh (ms): checks run on a background thread, the probe
# serves the last published result. 0 disables the refresher (synchronous probe).
# HEALTH_SNAPSHOT_REFRESH_MS=5000
# SHUTDOWN_DRAIN_TIMEOUT_MS=10000
# HEALTH_CHECK_SERVICE_PATH=

# ---- Dynamic flags ----
# REMOTE_LOG_URL=                      # poll remote endpoint for log level
# REMOTE_LOG_REFRESH_INTERVAL=

# ---- SQL ----
# DB_DIALECT=postgres                  # postgres|mysql|sqlite|duckdb|duckgres|clickhouse|supabase|cassandra
# DB_HOST=
# DB_PORT=
# DB_USER=
# DB_PASSWORD=
# DB_NAME=
# DB_TLS_ROOT_CA=                    # postgres DB_SSL_MODE=verify-* CA file
# DB_SSL_MODE=disable                # postgres: disable|require|verify-ca|verify-full
# PG_POOL_SIZE=
# PG_POOL_ACQUIRE_TIMEOUT_MS=
# SQL_CIRCUIT_BREAKER_ENABLE=
# MYSQL_POOL_SIZE=10                   # mysql pool size (default 10)
# MYSQL_SSL_MODE=disabled              # mysql only: disabled|preferred|required
# MYSQL_SSL_CA=                        # required|verify: CA bundle to check server cert+host
# SQLITE_PATH=
# SQLITE_CREATE=
# SQLITE_WRITE=
# SQLITE_THREADING=
# DUCKDB_PATH=
# CLICKHOUSE_URL=
# CLICKHOUSE_DB=
# CLICKHOUSE_USER=
# CLICKHOUSE_PASSWORD=
# CASSANDRA_CONTACT_POINTS=
# CASSANDRA_KEYSPACE=
# CASSANDRA_USER=
# CASSANDRA_PASSWORD=
# CASSANDRA_TLS_ENABLED=
# CASSANDRA_TLS_VERIFY=
# CASSANDRA_TLS_CA=
# CASSANDRA_TLS_CERT_FILE=
# CASSANDRA_TLS_KEY_FILE=
# CASSANDRA_TLS_SERVER_NAME=

# ---- Supabase SQL (DB_DIALECT=supabase) ----
# SUPABASE_DB_HOST=
# SUPABASE_DB_PORT=5432
# SUPABASE_DB_USER=
# SUPABASE_DB_PASSWORD=
# SUPABASE_DB_NAME=
# SUPABASE_DB_PROJECT=
# SUPABASE_DB_SSL_MODE=require

# ---- Cache & KV (Redis) ----
# CACHE_CIRCUIT_BREAKER_ENABLE=
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_USER=default
# REDIS_PASSWORD=
# REDIS_DB=0
# REDIS_CONNECT_RETRIES=5
# REDIS_CONNECT_BACKOFF_MS=500

# ---- Rate limiting ----
# RATE_LIMIT_ENABLE=
# RATE_LIMIT_STORE=memory              # or redis (uses REDIS_HOST/REDIS_PORT)
# RATE_LIMIT_KEY=ip                    # or header:X-Forwarded-For
# RATE_LIMIT_MAX=
# RATE_LIMIT_WINDOW=
# RATE_LIMIT_TRUSTED_PROXIES=10.0.0.0/8

# ---- Pub/sub ----
# PUBSUB_BACKEND=kafka                 # mqtt|kafka|nats|redis|SQS|GCP
# PUBSUB_BROKER=localhost:9092
# CONSUMER_ID=
# MQTT_HOST=localhost
# MQTT_PORT=1883
# MQTT_PROTOCOL=tcp
# MQTT_USER=
# MQTT_PASSWORD=
# MQTT_KEEP_ALIVE=
# MQTT_QOS=
# MQTT_CLIENT_ID_SUFFIX=-none
# MQTT_RETRIEVE_RETAINED=
# KAFKA_BATCH_BYTES=1048576
# KAFKA_BATCH_TIMEOUT=1000
# KAFKA_BATCH_SIZE=100
# KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# KAFKA_SASL_MECHANISM=PLAIN
### KAFKA SASL credentials: KAFKA_SASL_USERNAME / KAFKA_SASL_PASSWORD (see configs/.env keys below)
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=
# KAFKA_TLS_CERT_FILE=
# KAFKA_TLS_KEY_FILE=
# KAFKA_TLS_CA_CERT_FILE=
# KAFKA_TLS_INSECURE_SKIP_VERIFY=false
# NATS_STREAM=
# NATS_SUBJECTS=
# NATS_CONSUMER=
# NATS_CREDS_FILE=
# NATS_MAX_WAIT=
# NATS_MAX_PULL_WAIT=
# GCP_PROJECT=
# GCP_SUBSCRIPTION=
# GCP_CLIENT_ID=
# GCP_CLIENT_SECRET=
# GCP_ENDPOINT=https://pubsub.googleapis.com
# GCP_SCOPE=https://www.googleapis.com/auth/pubsub
# GCP_TOKEN_URL=https://oauth2.googleapis.com/token
# GCP_ACCESS_TOKEN=
# SQS_QUEUE_URL=
# AWS_REGION=us-east-1                 # SQS SigV4 signing region
# AWS_ACCESS_KEY=
# AWS_SECRET_KEY=

# ---- Auth ----
# AUTH_MODE=APIKey                     # Basic | APIKey | OAuth
# AUTH_KEYS=                           # JSON key claims store (APIKey mode)
# AUTH_API_KEYS=                       # comma-list API keys
# AUTH_JWKS_URL=                       # JWKS refresh endpoint (JWT mode)
# AUTH_REFRESH_INTERVAL=
# OAUTH_ISSUER=
# OAUTH_AUDIENCE=

# ---- NoSQL ----
# ARANGO_HOST=
# ARANGO_DB=
# ARANGO_USER=
# ARANGO_PASSWORD=
# COUCHBASE_CONTACT_POINTS=
# COUCHBASE_BUCKET=
# COUCHBASE_USER=
# COUCHBASE_PASSWORD=
# MONGODB_CONTACT_POINTS=
# MONGODB_DB=
# MONGODB_USER=
# MONGODB_PASSWORD=
# MONGODB_AUTH_SOURCE=
# MONGODB_TLS=
# MONGODB_TLS_VERIFY=
# MONGODB_TLS_CA=
# MONGODB_TLS_CERT_FILE=
# MONGODB_TLS_KEY_FILE=
# MONGODB_TLS_SERVER_NAME=

# ---- Time-series ----
# INFLUXDB_URL=
# INFLUXDB_BUCKET=
# INFLUXDB_TOKEN=
# OPENTSDB_URL=
# OPENTSDB_TOKEN=

# ---- Search ----
# SOLR_URL=
# SOLR_DEFAULT_COLLECTION=
# SOLR_BASIC_AUTH=
# MEILI_HOST=
# MEILI_INDEX=
# MEILI_API_KEY=

# ---- Graph (DGraph) ----
# DGRAPH_URL=
# DGRAPH_API_KEY=

# ---- File stores ----
# FILE_STORE_BACKEND=local             # local|s3|supabase|gcs
# FILE_STORE_ROOT=./data/files
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# GCS_BUCKET=
# GCS_PROJECT=
# GCS_CLIENT_ID=
# GCS_CLIENT_SECRET=
# GCS_ENDPOINT=https://storage.googleapis.com
# GCS_SCOPE=https://www.googleapis.com/auth/devstorage.full_control
# GCS_TOKEN_URL=https://oauth2.googleapis.com/token
# GCS_ACCESS_TOKEN=
# SUPABASE_STORAGE_PROJECT=
# SUPABASE_STORAGE_BUCKET=
# SUPABASE_STORAGE_REGION=us-east-1
# SUPABASE_STORAGE_ENDPOINT=
# SUPABASE_STORAGE_ACCESS_KEY=
# SUPABASE_STORAGE_SECRET_KEY=

# ---- Vault ----
# VAULT_ADDR=
# VAULT_TOKEN=
# VAULT_ROLE_ID=
# VAULT_SECRET_ID=
# VAULT_SECRETS_PATH=

# ---- Outbound service (example: app.addHttpService("orders", ...)) ----
# SERVICE_ORDERS_BASE_URL=http://orders.svc.cluster.local:8080
# SERVICE_ORDERS_AUTH_MODE=ApiKey
# SERVICE_ORDERS_API_KEY=
# SERVICE_ORDERS_CB_FAILURE_THRESHOLD=5
# SERVICE_ORDERS_CB_COOLDOWN_MS=30000
# SERVICE_ORDERS_TIMEOUT_MS=5000
# SERVICE_ORDERS_MAX_RETRIES=2
# SERVICE_ORDERS_RETRY_BASE_MS=200
# SERVICE_ORDERS_RATE_LIMIT=100
# SERVICE_ORDERS_RATE_LIMIT_WINDOW_MS=1000

# ---- Observability ----
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer xxx
# OTEL_EXPORTER_OTLP_AUTH_HEADER=
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=
# OTEL_SERVICE_NAME=
# OTEL_LOG_JSON=
