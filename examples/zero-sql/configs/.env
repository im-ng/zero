APP_ENV=dev
APP_NAME=zero-sql
APP_VERSION=1.0.0
LOG_LEVEL=debug
HTTP_PORT=8080

# ---------------------------------------------------------------------------
# zero-sql is a multi-dialect pack. Only ONE SQL backend binds to ctx.SQL at a
# time, selected by DB_DIALECT (or an explicit app.add* call in main.zig). The
# matching dialect's migration under src/migrations/ runs on startup; the other
# three are scoped out and skipped. Uncomment exactly one block.
# ---------------------------------------------------------------------------

# --- SQLite (in-process, zero external services) ---
DB_DIALECT=sqlite
SQLITE_PATH=./data/app.db
SQLITE_CREATE=true
SQLITE_WRITE=true

# --- DuckDB (in-process OLAP) ---
# DB_DIALECT=duckdb
# DUCKDB_PATH=./data/app.db

# --- PostgreSQL (network) ---
# DB_DIALECT=postgres
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=app
# DB_SSL_MODE=disable

# --- CockroachDB (Postgres wire-compatible) ---
# CockroachDB speaks the PostgreSQL wire protocol, so it is served by the
# existing `postgres` SQL backend — no separate block or backend is needed.
# Switch DB_DIALECT to postgres and point the PostgreSQL fields at a CockroachDB
# node (default port 26257) to use it:
# DB_DIALECT=postgres
# DB_HOST=127.0.0.1
# DB_PORT=26257
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=defaultdb

# --- Supabase (managed Postgres) ---
# Supabase is Postgres, so select DB_DIALECT=supabase and supply the SUPABASE_DB_*
# keys — no need to also set the generic DB_* keys. Uses SUPABASE_DB_HOST or the
# project ref to derive db.<ref>.supabase.co; TLS is forced (SUPABASE_DB_SSL_MODE).
# DB_DIALECT=supabase
# SUPABASE_DB_PROJECT=your-project-ref
# SUPABASE_DB_HOST=db.your-project-ref.supabase.co
# SUPABASE_DB_PORT=5432
# SUPABASE_DB_USER=postgres
# SUPABASE_DB_PASSWORD=
# SUPABASE_DB_NAME=postgres
# SUPABASE_DB_SSL_MODE=require

# --- ClickHouse (HTTP, columnar OLAP) ---
# DB_DIALECT=clickhouse
# CLICKHOUSE_URL=http://127.0.0.1:8123
# CLICKHOUSE_DB=default
# CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=

ZERO_HTTP_LARGE_BUFFER_SIZE=1048576
ZERO_HTTP_LARGE_BUFFER_COUNT=16

RATE_LIMIT_ENABLE=false
ZERO_REQUEST_TIMEOUT_MS=30000
INBOUND_MAX_CONCURRENT=0

FILE_STORE_ROOT=./data/sql-store
FILE_STORE_BACKEND=local
