APP_ENV=dev
APP_NAME=zero-sql
APP_VERSION=1.0.0
LOG_LEVEL=debug
HTTP_PORT=8080

# ---------------------------------------------------------------------------
# zero-sql is a multi-dialect pack. Only ONE SQL backend binds to ctx.SQL at a
# time, selected by DB_DIALECT (or an explicit app.add* call in main.zig). The
# matching dialect's migration under src/migrations/ runs on startup; the other
# three are scoped out and skipped. Uncomment exactly one block.
# ---------------------------------------------------------------------------

# --- SQLite (in-process, zero external services) ---
DB_DIALECT=sqlite
SQLITE_PATH=./data/app.db
SQLITE_CREATE=true
SQLITE_WRITE=true

# --- DuckDB (in-process OLAP) ---
# DB_DIALECT=duckdb
# DUCKDB_PATH=./data/app.db

# --- PostgreSQL (network) ---
# DB_DIALECT=postgres
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=app
# DB_SSL_MODE=disable

# --- ClickHouse (HTTP, columnar OLAP) ---
# DB_DIALECT=clickhouse
# CLICKHOUSE_URL=http://127.0.0.1:8123
# CLICKHOUSE_DB=default
# CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=

ZERO_HTTP_LARGE_BUFFER_SIZE=1048576
ZERO_HTTP_LARGE_BUFFER_COUNT=16

RATE_LIMIT_ENABLE=false
ZERO_REQUEST_TIMEOUT_MS=30000
INBOUND_MAX_CONCURRENT=0

FILE_STORE_ROOT=./data/sql-store
FILE_STORE_BACKEND=local
