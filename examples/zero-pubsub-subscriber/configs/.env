APP_NAME=pubsub-subscriber
LOG_LEVEL=info
HTTP_PORT=8081

# ----------------------------------------------------------------------------
# PubSub backend selection. Set PUBSUB_BACKEND to one of:
#   MQTT  - needs MQTT_HOST / MQTT_PORT (MQTT_* below)
#   KAFKA - needs PUBSUB_BROKER and CONSUMER_ID (consumer group)
#   NATS  - needs PUBSUB_BROKER (nats://host:port); JetStream fields optional
# (REDIS is also supported by the framework but out of scope for this demo.)
# ----------------------------------------------------------------------------
PUBSUB_BACKEND=MQTT
PUBSUB_TOPIC=zero

# --- MQTT ---
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
MQTT_CLIENT_ID_SUFFIX=-sub
MQTT_QOS=0
MQTT_RETRIEVE_RETAINED=false

# --- Kafka / NATS (shared broker endpoint) ---
PUBSUB_BROKER=127.0.0.1:9092
# Kafka consumer group id (required for Kafka)
CONSUMER_ID=zero-group
# NATS JetStream settings (optional)
NATS_STREAM=
NATS_CONSUMER=
NATS_SUBJECTS=
