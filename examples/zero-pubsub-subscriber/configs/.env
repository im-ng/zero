APP_NAME=pubsub-publisher
LOG_LEVEL=info
HTTP_PORT=8080

# ----------------------------------------------------------------------------
# PubSub backend selection. Set PUBSUB_BACKEND to one of:
#   MQTT  - needs MQTT_HOST / MQTT_PORT (MQTT_* below)
#   KAFKA - needs PUBSUB_BROKER (bootstrap.servers) and, for the subscriber, CONSUMER_ID
#   NATS  - needs PUBSUB_BROKER (nats://host:port); JetStream fields optional
# (REDIS is also supported by the framework but out of scope for this demo.)
# ----------------------------------------------------------------------------
PUBSUB_BACKEND=NATS
PUBSUB_TOPIC=zero
# PUBSUB_BROKER=127.0.0.1:9092
PUBSUB_BROKER="localhost:4222"
# Kafka consumer group id (required by the subscriber example; leave empty to publish)
CONSUMER_ID=zero-group

# --- MQTT ---
# MQTT_HOST=127.0.0.1
# MQTT_PORT=1883
# MQTT_USER=
# MQTT_PASSWORD=
# MQTT_CLIENT_ID_SUFFIX=-pub
# MQTT_QOS=0
# MQTT_RETRIEVE_RETAINED=false

# --- NATS (shared broker endpoint) ---
NATS_STREAM=zero-stream
NATS_SUBJECTS=zero
NATS_MAX_WAIT=5000
NATS_MAX_PULL_WAIT=5000
NATS_CONSUMER=zero-consumer
# NATS_CREDS_FILE=/path/to/creds.creds

# --- Kafka ---
KAFKA_BATCH_SIZE=1000
KAFKA_BATCH_BYTES=1048576
KAFKA_BATCH_TIMEOUT=300
# switch kafka pods based on this mechanism
KAFKA_SASL_MECHANISM=PLAINTEXT
# KAFKA_SECURITY_PROTOCOL=SASL_PLAINTEXT
# KAFKA_SASL_MECHANISM=PLAIN
# KAFKA_SASL_USERNAME=admin
# KAFKA_SASL_PASSWORD=secret