APP_NAME=zero-nats-publisher
APP_VERSION=1.0.0
APP_ENV=dev
LOG_LEVEL=debug
HTTP_PORT=8092

PUBSUB_BACKEND=NATS
PUBSUB_BROKER=nats://localhost:4222
NATS_STREAM=zero-stream
NATS_SUBJECTS=zero
NATS_MAX_WAIT=5000
NATS_MAX_PULL_WAIT=5000
NATS_CONSUMER=zero-consumer
# NATS_CREDS_FILE=/path/to/creds.creds

# --- Resilience (opt-in; see README "Resilience") ---
# ZERO_REQUEST_TIMEOUT_MS=30000
# INBOUND_MAX_CONCURRENT=100
# SQL_CIRCUIT_BREAKER_ENABLE=true
# CACHE_CIRCUIT_BREAKER_ENABLE=true
# REQUIRED_CONFIG_KEYS=DB_HOST,DB_NAME
# LOG_FORMAT=json
