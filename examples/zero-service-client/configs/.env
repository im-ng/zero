APP_ENV=dev
APP_NAME=service-client
APP_VERSION=1.0.0
LOG_LEVEL=debug

HTTP_PORT=9090
SERVICE_URL="http://localhost:8082"

# --- Framework defaults for example
ZERO_FRAMEWORK_MEM_SIZE=8
ZERO_HTTP_WORKERS=2
ZERO_HTTP_MAX_BODY_SIZE=2388608
ZERO_HTTP_LARGE_BUFFER_SIZE=2388608
ZERO_HTTP_LARGE_BUFFER_COUNT=8
ZERO_HTTP_THREAD_POOL_COUNT=16

# --- Resilience 
RATE_LIMIT_ENABLE=false
ZERO_REQUEST_TIMEOUT_MS=30000
INBOUND_MAX_CONCURRENT=0

AUTH_MODE=oauth
AUTH_OAUTH_TOKEN_URL=http://localhost:9990/realms/zero/protocol/openid-connect/token
