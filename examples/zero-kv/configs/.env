APP_ENV=dev
APP_NAME=zero-kv
APP_VERSION=1.0.0
LOG_LEVEL=debug
HTTP_PORT=8080

# ---------------------------------------------------------------------------
# zero-kv is a multi-backend KV pack. Each backend only wires when its env is
# present, so the example runs with zero external services (a memory store) and
# lights up sqlite / redis / nats as they become available. Uncomment a block to
# enable that backend; a registered store is then reachable at /kv/<name>/<key>.
# ---------------------------------------------------------------------------

# --- SQLite KV (needs SQLite active) ---
# DB_DIALECT=sqlite
# SQLITE_PATH=./data/kv.db
# SQLITE_CREATE=true
# SQLITE_WRITE=true

# --- Redis KV (needs Redis) ---
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_DB=0

# --- NATS KV (needs NATS + JetStream) ---
# PUBSUB_BACKEND=nats
# PUBSUB_BROKER=nats://localhost:4222
# NATS_STREAM=zero
# NATS_SUBJECTS=zero.>
# NATS_CONSUMER=zero-consumer

# --- AWS SQS (pub/sub) ---
# PUBSUB_BACKEND=SQS
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY=your-access-key
# AWS_SECRET_KEY=your-secret-key
# SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/000000000000/your-queue

# --- GCP Pub/Sub (pub/sub) ---
# PUBSUB_BACKEND=GCP
# GCP_PROJECT=your-gcp-project
# GCP_SUBSCRIPTION=your-subscription
# GCP_ENDPOINT=https://pubsub.googleapis.com
# GCP_TOKEN_URL=https://oauth2.googleapis.com/token
# GCP_SCOPE=https://www.googleapis.com/auth/pubsub
# GCP_CLIENT_ID=your-client-id
# GCP_CLIENT_SECRET=your-client-secret
# GCP_ACCESS_TOKEN=                     # optional; overrides client-credentials grant

RATE_LIMIT_ENABLE=false
ZERO_REQUEST_TIMEOUT_MS=30000
INBOUND_MAX_CONCURRENT=0

FILE_STORE_ROOT=./data/kv-store
FILE_STORE_BACKEND=local
