# Application Settings
APP_NAME=duckgres-demo
LOG_LEVEL=info
HTTP_PORT=8080

# Database Configuration — wired DuckDB (DuckGres)
# Speaks the Postgres wire protocol to a DuckDB PG-wire front-end
# (e.g. duckgres / PostDuck). Reuses the shared DB_* connection settings.
DB_DIALECT=duckgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=user1
DB_PASSWORD=password1
DB_NAME=demo
DB_SSL_MODE=disable

# --- Framework defaults for example
ZERO_FRAMEWORK_MEM_SIZE=8
ZERO_HTTP_WORKERS=2
ZERO_HTTP_MAX_BODY_SIZE=2388608
ZERO_HTTP_LARGE_BUFFER_SIZE=2388608
ZERO_HTTP_LARGE_BUFFER_COUNT=8
ZERO_HTTP_THREAD_POOL_COUNT=16

# --- Resilience 
RATE_LIMIT_ENABLE=false
ZERO_REQUEST_TIMEOUT_MS=30000
INBOUND_MAX_CONCURRENT=0
