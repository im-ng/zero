# Application Settings
APP_NAME=duckgres-demo
LOG_LEVEL=info
HTTP_PORT=8080

# Database Configuration — wired DuckDB (DuckGres)
# Speaks the Postgres wire protocol to a DuckDB PG-wire front-end
# (e.g. duckgres / PostDuck). Reuses the shared DB_* connection settings.
DB_DIALECT=duckgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=user1
DB_PASSWORD=password1
DB_NAME=demo
DB_SSL_MODE=disable

# --- Resilience (opt-in; see README "Resilience") ---
# ZERO_REQUEST_TIMEOUT_MS=30000
# INBOUND_MAX_CONCURRENT=100
# SQL_CIRCUIT_BREAKER_ENABLE=true
# CACHE_CIRCUIT_BREAKER_ENABLE=true
# REQUIRED_CONFIG_KEYS=DB_HOST,DB_NAME
# LOG_FORMAT=json
