APP_NAME=pubsub-publisher
LOG_LEVEL=info
HTTP_PORT=8080

# ----------------------------------------------------------------------------
# PubSub backend selection. Set PUBSUB_BACKEND to one of:
#   MQTT  - needs MQTT_HOST / MQTT_PORT (MQTT_* below)
#   KAFKA - needs PUBSUB_BROKER (bootstrap.servers) and, for the subscriber, CONSUMER_ID
#   NATS  - needs PUBSUB_BROKER (nats://host:port); JetStream fields optional
#   SQS   - needs AWS_REGION / AWS_ACCESS_KEY / AWS_SECRET_KEY / SQS_QUEUE_URL (SQS_* below)
#   GCP   - needs GCP_PROJECT / GCP_SUBSCRIPTION (GCP_* below)
#   REDIS - supported by the framework but out of scope for this demo
# ----------------------------------------------------------------------------
PUBSUB_BACKEND=NATS
# PUBSUB_TOPIC=zero
# PUBSUB_BROKER="localhost:9092"
PUBSUB_BROKER="localhost:4222"
# Kafka consumer group id (required by the subscriber example; leave empty to publish)
CONSUMER_ID=

# --- MQTT ---
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
MQTT_CLIENT_ID_SUFFIX=-pub
# MQTT_QOS=0
# MQTT_RETRIEVE_RETAINED=false

# --- NATS (shared broker endpoint) ---
NATS_STREAM=zero-stream
NATS_SUBJECTS=zero
NATS_MAX_WAIT=5000
NATS_MAX_PULL_WAIT=5000
NATS_CONSUMER=zero-consumer
# NATS_CREDS_FILE=/path/to/creds.creds

# --- Kafka ---
KAFKA_BATCH_SIZE=1000
KAFKA_BATCH_BYTES=1048576
KAFKA_BATCH_TIMEOUT=300
# switch kafka pods based on this mechanism
KAFKA_SASL_MECHANISM=PLAINTEXT
# KAFKA_SECURITY_PROTOCOL=SASL_PLAINTEXT
# KAFKA_SASL_MECHANISM=PLAIN
# KAFKA_SASL_USERNAME=admin
# KAFKA_SASL_PASSWORD=secret

# --- AWS SQS (pub/sub backend) ---
# PUBSUB_BACKEND=SQS
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY=your-access-key
# AWS_SECRET_KEY=your-secret-key
# SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/000000000000/your-queue

# --- GCP Pub/Sub (pub/sub backend) ---
# PUBSUB_BACKEND=GCP
# GCP_PROJECT=your-gcp-project
# GCP_SUBSCRIPTION=your-subscription
# GCP_ENDPOINT=https://pubsub.googleapis.com
# GCP_TOKEN_URL=https://oauth2.googleapis.com/token
# GCP_SCOPE=https://www.googleapis.com/auth/pubsub
# GCP_CLIENT_ID=your-client-id
# GCP_CLIENT_SECRET=your-client-secret
# GCP_ACCESS_TOKEN=                     # optional; overrides client-credentials grant