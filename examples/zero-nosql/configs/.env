APP_ENV=dev
APP_NAME=nosql-example
APP_VERSION=1.0.0
LOG_LEVEL=debug
HTTP_PORT=8080

# --- Cassandra (wide-column NoSQL) ---
# The example reads these and the framework auto-wires ctx.NoSQL. Leave them unset
# to run with the routes returning 501 ("not configured"). Point them at a running
# Cassandra (e.g. the one on 127.0.0.1:9042) to exercise the CRUD routes.
CASSANDRA_CONTACT_POINTS=127.0.0.1:9042
CASSANDRA_KEYSPACE=demo
CASSANDRA_USER=cassandra
CASSANDRA_PASSWORD=cassandra

# --- Couchbase (document, N1QL/HTTP, no libcouchbase) ---
# Comment out the CASSANDRA_* block above and uncomment these to switch the
# active backend. The runner then applies create_schema_couchbase.zig instead.
# COUCHBASE_CONTACT_POINTS=localhost:8091
# COUCHBASE_BUCKET=demo
# COUCHBASE_USER=admin
# COUCHBASE_PASSWORD=password

# --- ArangoDB (multi-model / document, HTTP via zul) ---
# Comment out the CASSANDRA_* block above and uncomment these to switch the
# active NoSQL backend to ArangoDB. The framework auto-wires ctx.NoSQL.
# ARANGO_HOST=http://localhost:8529
# ARANGO_DB=_system
# ARANGO_USER=root
# ARANGO_PASSWORD=

# --- ScyllaDB (wide-column, CQL/Cassandra wire-compatible) ---
# ScyllaDB speaks the Cassandra CQL protocol, so it is served by the existing
# `cassandra` NoSQL backend — no separate block is needed. Point the CASSANDRA_*
# block above at a ScyllaDB node (default port 9042) to use it.

ZERO_HTTP_LARGE_BUFFER_SIZE=1048576      # 1 MiB per pooled body buffer
ZERO_HTTP_LARGE_BUFFER_COUNT=16          # pooled body buffers (≈ pool size resident)

# --- Resilience (opt-in; see README "Resilience") ---
RATE_LIMIT_ENABLE=false
ZERO_REQUEST_TIMEOUT_MS=30000
INBOUND_MAX_CONCURRENT=0

FILE_STORE_ROOT=./data/nosql-store
FILE_STORE_BACKEND=local
