APP_ENV=dev
APP_NAME=nosql-example
APP_VERSION=1.0.0
LOG_LEVEL=debug
HTTP_PORT=8090

# --- Cassandra (wide-column NoSQL) ---
# The example reads these and the framework auto-wires ctx.NoSQL. Leave them unset
# to run with the routes returning 501 ("not configured"). Point them at a running
# Cassandra (e.g. the one on 127.0.0.1:9042) to exercise the CRUD routes.
# Keep the contact point an IP literal: Zig 0.16's net.IpAddress.resolve only
# parses IP literals (no DNS), so a hostname here would fail to connect. When
# TLS VERIFY=true, point CASSANDRA_TLS_SERVER_NAME at a dNSName from the server
# cert (Zig matches dNSName SANs only, not iPAddress) so the cert verifies.
CASSANDRA_CONTACT_POINTS=127.0.0.1:9042
CASSANDRA_KEYSPACE=demo
CASSANDRA_USER=cassandra
CASSANDRA_PASSWORD=cassandra
# Optional TLS for the Cassandra native (CQL) port. Set ENABLED=true to wrap the
# connection in TLS. VERIFY=true additionally verifies the server certificate
# against CA_PATH (e.g. an mkcert rootCA.pem). With VERIFY=false the handshake
# still encrypts but does not validate the certificate.
CASSANDRA_TLS_ENABLED=true
CASSANDRA_TLS_VERIFY=true
CASSANDRA_TLS_CA=/media/ng/home/zig-self-learning/zero/tls/cassandra/certs/rootCA.pem
# Hostname verified against the server cert's dNSName SAN (the cert lists
# 127.0.0.1 only as iPAddress, which Zig does not match). Must be reachable as
# a dNSName on the cert, e.g. `localhost` or `cassandra`.
CASSANDRA_TLS_SERVER_NAME=localhost

# --- Couchbase (document, N1QL/HTTP, no libcouchbase) ---
# Comment out the CASSANDRA_* block above and uncomment these to switch the
# active backend. The runner then applies create_schema_couchbase.zig instead.
# COUCHBASE_CONTACT_POINTS=localhost:8091
# COUCHBASE_BUCKET=demo
# COUCHBASE_USER=admin
# COUCHBASE_PASSWORD=password

# --- ArangoDB (multi-model / document, HTTP via zul) ---
# Comment out the CASSANDRA_* block above and uncomment these to switch the
# active NoSQL backend to ArangoDB. The framework auto-wires ctx.NoSQL.
# ARANGO_HOST=http://localhost:8529
# ARANGO_DB=_system
# ARANGO_USER=root
# ARANGO_PASSWORD=

# --- ScyllaDB (wide-column, CQL/Cassandra wire-compatible) ---
# ScyllaDB speaks the Cassandra CQL protocol, so it is served by the existing
# `cassandra` NoSQL backend — no separate block is needed. Point the CASSANDRA_*
# block above at a ScyllaDB node (default port 9042) to use it.

# --- Framework defaults for example
ZERO_FRAMEWORK_MEM_SIZE=8
ZERO_HTTP_WORKERS=2
ZERO_HTTP_MAX_BODY_SIZE=2388608
ZERO_HTTP_LARGE_BUFFER_SIZE=2388608
ZERO_HTTP_LARGE_BUFFER_COUNT=8
ZERO_HTTP_THREAD_POOL_COUNT=16

# --- Resilience 
RATE_LIMIT_ENABLE=false
ZERO_REQUEST_TIMEOUT_MS=30000
INBOUND_MAX_CONCURRENT=0

FILE_STORE_ROOT=./data/nosql-store
FILE_STORE_BACKEND=local
