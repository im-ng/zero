APP_NAME=zero-filestore
APP_VERSION=1.0.0
APP_ENV=dev
LOG_LEVEL=debug

HTTP_PORT=8080

# --- Framework defaults for example
ZERO_FRAMEWORK_MEM_SIZE=8
ZERO_HTTP_WORKERS=2
ZERO_HTTP_MAX_BODY_SIZE=2388608
ZERO_HTTP_LARGE_BUFFER_SIZE=2388608
ZERO_HTTP_LARGE_BUFFER_COUNT=8
ZERO_HTTP_THREAD_POOL_COUNT=16

# --- Resilience 
RATE_LIMIT_ENABLE=false
ZERO_REQUEST_TIMEOUT_MS=30000
INBOUND_MAX_CONCURRENT=0

# File store backends: local | s3 | supabase. The `supabase` backend is the
# S3-compatible Supabase Storage API, so it reuses the S3 transport (SigV4).
FILE_STORE_ROOT=./data/files
# FILE_STORE_BACKEND=s3
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_BUCKET=zero
# S3_REGION=in-south
# S3_ACCESS_KEY=i8JHSTGMLV9Jw9U76jfk
# S3_SECRET_KEY=lZUQTkpqidCVtzhQAjI9O4fsPprPFpDl4FrabUe3

# Supabase Storage (S3-compatible). Use the "S3 Access Keys" from the Supabase
# Storage settings panel (not the anon/service-role JWTs).
# FILE_STORE_BACKEND=supabase
# SUPABASE_STORAGE_PROJECT=your-project-ref
# SUPABASE_STORAGE_BUCKET=my-bucket
# SUPABASE_STORAGE_REGION=us-east-1
# SUPABASE_STORAGE_ACCESS_KEY=
# SUPABASE_STORAGE_SECRET_KEY=

# GCS (Google Cloud Storage). Token via client-credentials grant, or inject one
# directly with GCS_ACCESS_TOKEN.
# FILE_STORE_BACKEND=gcs
# GCS_BUCKET=my-bucket
# GCS_PROJECT=my-project
# GCS_CLIENT_ID=
# GCS_CLIENT_SECRET=
# GCS_ACCESS_TOKEN=
