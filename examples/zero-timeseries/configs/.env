APP_ENV=dev
APP_NAME=timeseries-example
APP_VERSION=1.0.0
LOG_LEVEL=debug
HTTP_PORT=8080

# --- InfluxDB (time-series) ---
# The example reads these and the framework auto-wires ctx.Timeseries. Leave them
# unset to run with the routes returning 501 ("not configured"). Point them at a
# running InfluxDB v2 (e.g. http://localhost:8086) to exercise the write/query routes.
INFLUXDB_URL=http://127.0.0.1:8181
INFLUXDB_BUCKET=demo
INFLUXDB_TOKEN="apiv3_Kbu48sK9Zi4TZ83vzjQnT_oSr3yXty_sDk41IIffqe8lOrieT7YBxU9Vk1vhX6XxRfqa72-1GqvEiiX8eo1AlQ"

ZERO_HTTP_LARGE_BUFFER_SIZE=1048576      # 1 MiB per pooled body buffer
ZERO_HTTP_LARGE_BUFFER_COUNT=16          # pooled body buffers (≈ pool size resident)

# --- Resilience (opt-in; see README "Resilience") ---
RATE_LIMIT_ENABLE=false
ZERO_REQUEST_TIMEOUT_MS=30000
INBOUND_MAX_CONCURRENT=0

FILE_STORE_ROOT=./data/timeseries-store
FILE_STORE_BACKEND=local
