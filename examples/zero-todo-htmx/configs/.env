APP_ENV=dev
APP_NAME=zero-todo-htmx
APP_VERSION=1.0.0
LOG_LEVEL=info

DB_HOST=localhost
DB_USER=user1
DB_PASSWORD=password1
DB_NAME=demo
DB_PORT=5432
DB_DIALECT=postgres

# Enable this if postgres runs with tls support
# DB_SSL_MODE=require
# DB_TLS_ROOT_CA="./certs/rootCA.pem"


RATE_LIMIT_ENABLE=false
ZERO_REQUEST_TIMEOUT_MS=30000
INBOUND_MAX_CONCURRENT=0

ZERO_FRAMEWORK_MEM_SIZE=32
ZERO_HTTP_WORKERS=2
ZERO_HTTP_MAX_BODY_SIZE=2388608
ZERO_HTTP_LARGE_BUFFER_SIZE=2388608
ZERO_HTTP_LARGE_BUFFER_COUNT=8
ZERO_HTTP_THREAD_POOL_COUNT=32

# ZERO_REQUEST_TIMEOUT_MS=30000
# INBOUND_MAX_CONCURRENT=100
# SQL_CIRCUIT_BREAKER_ENABLE=true
# CACHE_CIRCUIT_BREAKER_ENABLE=true
# REQUIRED_CONFIG_KEYS=DB_HOST,DB_NAME
# LOG_FORMAT=json
