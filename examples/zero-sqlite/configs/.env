# SQLite Example Template
# ====================================
# Copy this to .dev.env and configure for your environment

# Application Settings
APP_ENV=dev
APP_NAME=sqlite-demo
LOG_LEVEL=debug
HTTP_PORT=8080

# --- Framework defaults for example
ZERO_FRAMEWORK_MEM_SIZE=8
ZERO_HTTP_WORKERS=2
ZERO_HTTP_MAX_BODY_SIZE=2388608
ZERO_HTTP_LARGE_BUFFER_SIZE=2388608
ZERO_HTTP_LARGE_BUFFER_COUNT=8
ZERO_HTTP_THREAD_POOL_COUNT=16

# --- Resilience 
RATE_LIMIT_ENABLE=false
ZERO_REQUEST_TIMEOUT_MS=30000
INBOUND_MAX_CONCURRENT=0

# Database Configuration
# Uncomment and configure the following to use SQLite:
DB_DIALECT=sqlite
SQLITE_PATH=./data/app.db
SQLITE_CREATE=true
SQLITE_WRITE=true
SQLITE_THREADING=multi-thread
