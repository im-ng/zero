# Auto CRUD Example Template
# ====================================
# Copy this to .dev.env and configure for your environment

# Application Settings
# APP_ENV=dev
APP_NAME=autocrud-demo
LOG_LEVEL=debug
HTTP_PORT=9082

# Database Configuration
DB_DIALECT=sqlite
SQLITE_PATH=/home/ng/zig-self-learnings/zero/examples/zero-autocrud/data/app.db
SQLITE_CREATE=true
SQLITE_WRITE=true
SQLITE_THREADING=multi-thread

# --- Resilience (opt-in; see README "Resilience") ---
# ZERO_REQUEST_TIMEOUT_MS=30000
# INBOUND_MAX_CONCURRENT=100
# SQL_CIRCUIT_BREAKER_ENABLE=true
# CACHE_CIRCUIT_BREAKER_ENABLE=true
# REQUIRED_CONFIG_KEYS=DB_HOST,DB_NAME
# LOG_FORMAT=json
