# Application Settings
APP_NAME=autocrud-demo
LOG_LEVEL=info
HTTP_PORT=8080

# Database Configuration
DB_DIALECT=sqlite
SQLITE_PATH=./data/app.db
SQLITE_CREATE=true
SQLITE_WRITE=true
SQLITE_THREADING=multi-thread

# --- Resilience 
RATE_LIMIT_ENABLE=false
ZERO_REQUEST_TIMEOUT_MS=30000
INBOUND_MAX_CONCURRENT=0
