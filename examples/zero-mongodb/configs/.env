APP_ENV=dev
APP_NAME=monogo-example
APP_VERSION=1.0.0
LOG_LEVEL=debug
HTTP_PORT=8080

MONGODB_CONTACT_POINTS=127.0.0.1:27017
MONGODB_DB=my_db
MONGODB_USER=app                         # optional (anonymous when empty)
MONGODB_PASSWORD=app123                   # optional
MONGODB_AUTH_SOURCE=my_db                # app user is defined in my_db
MONGODB_TLS=true                         # true | false (native OpenSSL TLS to MongoDB 8)
MONGODB_TLS_VERIFY=true                  # true | false
MONGODB_TLS_CA=/media/ng/home/zig-self-learning/zero/tls/mongodb/certs/ca.pem    # mkcert CA that signed the server cert
MONGODB_TLS_SERVER_NAME=localhost         # SNI / cert host (hostname, not IP literal)

ZERO_HTTP_LARGE_BUFFER_SIZE=1048576      # 1 MiB per pooled body buffer
ZERO_HTTP_LARGE_BUFFER_COUNT=16          # pooled body buffers (≈ pool size resident)

# --- Resilience (opt-in; see README "Resilience") ---
RATE_LIMIT_ENABLE=false
ZERO_REQUEST_TIMEOUT_MS=30000
INBOUND_MAX_CONCURRENT=0

FILE_STORE_ROOT=./data/nosql-store
FILE_STORE_BACKEND=local
