APP_ENV=dev
APP_NAME=search-example
APP_VERSION=1.0.0
LOG_LEVEL=debug
HTTP_PORT=8080

# --- Solr (search / persistence) ---
# The example reads these and the framework auto-wires ctx.Search. Leave them unset
# to run with the routes returning 501 ("not configured"). Point them at a running
# Solr (e.g. http://localhost:8983) with a collection named `docs`.
SOLR_URL=http://localhost:8983
SOLR_DEFAULT_COLLECTION=demo
# SOLR_BASIC_AUTH=user:pass            # optional HTTP Basic for the Solr endpoint

# --- Meilisearch (search, HTTP via zul) ---
# Meilisearch takes priority over Solr when MEILI_HOST is set. Uncomment to
# switch the active search backend; the framework auto-wires ctx.Search.
# MEILI_HOST=http://localhost:7700
# MEILI_INDEX=demo
# MEILI_API_KEY=masterKey            # optional; sent as Authorization: Bearer

ZERO_HTTP_LARGE_BUFFER_SIZE=1048576      # 1 MiB per pooled body buffer
ZERO_HTTP_LARGE_BUFFER_COUNT=16          # pooled body buffers (≈ pool size resident)

# --- Resilience (opt-in; see README "Resilience") ---
RATE_LIMIT_ENABLE=false
ZERO_REQUEST_TIMEOUT_MS=30000
INBOUND_MAX_CONCURRENT=0

FILE_STORE_ROOT=./data/search-store
FILE_STORE_BACKEND=local
