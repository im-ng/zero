APP_ENV=dev
APP_NAME=graph-example
APP_VERSION=1.0.0
LOG_LEVEL=debug
HTTP_PORT=8080

# --- Dgraph (graph database, HTTP query/mutate via zul) ---
# The example reads these and the framework auto-wires ctx.Graph. Leave them
# unset to run with the routes returning 501 ("not configured"). Point them at a
# running Dgraph (e.g. http://localhost:8080) to exercise the /query and /mutate
# routes.
DGRAPH_URL=http://localhost:8080
# DGRAPH_API_KEY=                     # optional; sent as X-Dgraph-AccessToken

ZERO_HTTP_LARGE_BUFFER_SIZE=1048576      # 1 MiB per pooled body buffer
ZERO_HTTP_LARGE_BUFFER_COUNT=16          # pooled body buffers (≈ pool size resident)

# --- Resilience (opt-in; see README "Resilience") ---
RATE_LIMIT_ENABLE=false
ZERO_REQUEST_TIMEOUT_MS=30000
INBOUND_MAX_CONCURRENT=0

FILE_STORE_ROOT=./data/graph-store
FILE_STORE_BACKEND=local
