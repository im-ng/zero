APP_ENV=dev
APP_NAME=zero-gcs
APP_VERSION=1.0.0
HTTP_PORT=8080

# Google Cloud Storage file store. Uncomment and fill before starting — the
# GCS backend connects lazily per request, but a bucket is required to serve.
# GCS_BUCKET=my-bucket
# GCS_PROJECT=my-project-123
# GCS_CLIENT_ID=...apps.googleusercontent.com
# GCS_CLIENT_SECRET=...
# GCS_ACCESS_TOKEN=ya29.....
# GCS_ENDPOINT=https://storage.googleapis.com
