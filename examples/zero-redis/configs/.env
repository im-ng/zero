APP_NAME=zero-redis
APP_VERSION=1.0.0
APP_ENV=dev
LOG_LEVEL=debug
HTTP_PORT=8081

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USER=redis # unused
REDIS_PASSWORD=password #unused
REDIS_DB=0

# --- Pub/Sub backends (SQS / GCP) ---
# PUBSUB_BACKEND=SQS
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY=your-access-key
# AWS_SECRET_KEY=your-secret-key
# SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/000000000000/your-queue

# PUBSUB_BACKEND=GCP
# GCP_PROJECT=your-gcp-project
# GCP_SUBSCRIPTION=your-subscription
# GCP_ENDPOINT=https://pubsub.googleapis.com
# GCP_TOKEN_URL=https://oauth2.googleapis.com/token
# GCP_SCOPE=https://www.googleapis.com/auth/pubsub
# GCP_CLIENT_ID=your-client-id
# GCP_CLIENT_SECRET=your-client-secret
# GCP_ACCESS_TOKEN=                     # optional; overrides client-credentials grant

# --- Resilience 
RATE_LIMIT_ENABLE=false
ZERO_REQUEST_TIMEOUT_MS=30000
INBOUND_MAX_CONCURRENT=0

# --- Resilience (opt-in; see README "Resilience") ---
# ZERO_REQUEST_TIMEOUT_MS=30000
# INBOUND_MAX_CONCURRENT=100
# SQL_CIRCUIT_BREAKER_ENABLE=true
# CACHE_CIRCUIT_BREAKER_ENABLE=true
# REQUIRED_CONFIG_KEYS=DB_HOST,DB_NAME
# LOG_FORMAT=json
